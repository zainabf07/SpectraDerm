# Where the FastAPI service is running. The dev server proxies /api to it.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Only needed if you serve the frontend separately from the API instead of
# using the dev proxy. Must include the version prefix.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
