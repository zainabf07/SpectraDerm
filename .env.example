# Optional paths may be absolute or relative to the repository root.
SPECTRADERM_DATA_DIR=data
SPECTRADERM_MODELS_DIR=models
SPECTRADERM_LOG_LEVEL=INFO
# Directories holding large raw datasets. Leave unset when raw data is unavailable.
SPECTRADERM_HYPERSKIN_ROOT=
SPECTRADERM_UMINHO_HSFD_ROOT=
# Optional deployed MST++ model. Without this, analysis runs the available RGB
# pipeline and reports spectral reconstruction as unavailable.
SPECTRADERM_MSTPP_CHECKPOINT=
SPECTRADERM_MSTPP_DEVICE=
# Optional comma-separated additional browser origins. Local Vite origins are
# allowed by default: http://localhost:5173 and http://127.0.0.1:5173.
SPECTRADERM_CORS_ORIGINS=
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
